{
  "name": "@cerebro-ide/ui-tooltip",
  "version": "0.0.0",
  "private": true,
  "description": "Tooltips in the app's own style, with the shortcut when there is one.",
  "type": "module",
  "exports": {
    ".": {
      "cerebro-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cerebro-ide/jsx": "0.0.0",
    "@cerebro-ide/reactive": "0.0.0"
  }
}
