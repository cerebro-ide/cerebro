{
  "name": "@cerebro-ide/servers",
  "version": "0.0.0",
  "private": true,
  "description": "The language servers Cerebro runs, and how each is started.",
  "type": "module",
  "exports": {
    ".": {
      "cerebro-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -b tsconfig.build.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "basedpyright": "1.40.2",
    "bash-language-server": "5.8.1",
    "typescript": "7.0.2",
    "vscode-css-languageservice": "6.3.10",
    "vscode-html-languageservice": "5.6.2",
    "vscode-json-languageservice": "5.7.2",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.15",
    "yaml-language-server": "2.0.0"
  }
}
